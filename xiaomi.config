#
# Target System & Subtarget
# 必须选择 MediaTek Ralink ARM 和 Filogic
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

#
# Target Profile
# 关键：WR30U 有两个版本，通常选择带 NMBM 支持的 112M 版本
# 如果是 AX3000T，配置项名称可能略有不同，但 WR30U 通常如下：
#
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-112m-nmbm=y

#
# Kernel modules -> Wireless Drivers
# MT7981 (Filogic 820) 必需的 Wi-Fi 驱动和固件
#
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7981-dbdc=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y

#
# Base System
#
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_mtd=y

#
# Network
# 基础网络支持，IPv6，防火墙
#
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_odhcpd6c=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-nat=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fib=y

#
# LuCI (Web Interface)
# 基础 LuCI 界面及中文支持
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

#
# Image Options
# 文件系统格式，WR30U 使用 UBI/SquashFS
#
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=112
CONFIG_TARGET_IMAGES_GZIP=y

#
# Global Build Settings
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y

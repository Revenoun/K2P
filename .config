#CONFIG_PACKAGE_kmod-nf-log6=y
#CONFIG_PACKAGE_kmod-nf-reject6=y
#CONFIG_PACKAGE_kmod-nft-bridge=y
#CONFIG_PACKAGE_kmod-nft-core=y
#CONFIG_PACKAGE_kmod-nft-netdev=y
#CONFIG_PACKAGE_luci-theme-bootstrap=y
#CONFIG_PACKAGE_luci-theme-aurora=y
#CONFIG_PACKAGE_libnftnl=y
#CONFIG_PACKAGE_luci-app-nft-qos=y
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
#CONFIG_PACKAGE_luci-i18n-nft-qos-zh-cn=y
#CONFIG_PACKAGE_nft-qos=y
#CONFIG_PACKAGE_nftables-nojson=y
# CONFIG_PACKAGE_vlmcsd is not set


# Target 平台定义
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# NFT-QoS所需内核模块与依赖
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_nft-qos=y
CONFIG_PACKAGE_luci-app-nft-qos=y
CONFIG_PACKAGE_luci-i18n-nft-qos-zh-cn=y
CONFIG_PACKAGE_nftables-nojson=y
# 屏蔽vlmcsd
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_vlmcsd is not set

# LuCI界面&主题：关闭bootstrap，启用Aurora
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
#CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y

# 全局基础工具
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_SUPPORTS_MAGIC=y
CONFIG_CCACHE=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssl-util=y

# 系统工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wol=y
CONFIG_PACKAGE_cpu-frequency=y
CONFIG_PACKAGE_luci-app-cpu-frequency=y

# TurboAccel网络加速
CONFIG_PACKAGE_turboacc=y
CONFIG_PACKAGE_luci-app-turboacc=y

# SSRPlus，不需要直接删除此行
CONFIG_PACKAGE_luci-app-ssrplus=y

# 在线升级
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# USB注释（K2P无USB，节省闪存）
# CONFIG_PACKAGE_kmod-usb-ohci=y
# CONFIG_PACKAGE_kmod-usb-uhci=y
# CONFIG_PACKAGE_kmod-usb2=y

# 精简IPv6无用组件，节约空间
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=n
CONFIG_PACKAGE_ipv6helper=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
